{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Appex Backup",
  "mainBinaryName": "appex-backup",
  "version": "../package.json",
  "identifier": "lat.appex.backup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Appex Backup",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Backups de instancias Odoo",
    "longDescription": "Appex Backup descarga backups .zip de instancias Odoo 15 a 19, guarda las credenciales cifradas y sube los backups a Google Drive.",
    "publisher": "AppexLat",
    "copyright": "© 2026 Felix Daniel Coca Calvimontes",
    "license": "MIT",
    "homepage": "https://github.com/drkpkg/appex-backup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/doc/appex-backup/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/licenses/appex-backup/LICENSE": "../LICENSE"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
